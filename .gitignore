# Ejecutables y archivos de depuracion
/Programs/*.exe
/Programs/*.dbg
/Programs/*.exe.manifest
/Programs/WebApp.log

# Archivos generados por el compilador
/AppSrc/*.dep
/AppSrc/*.fld
/AppSrc/*.pbg
/AppSrc/*.pdp
/AppSrc/*.pkd
/AppSrc/*.prp
/AppSrc/*.err
/AppSrc/*.prn

# Preferencias y metadatos locales de Studio
/IdeSrc/StudioMetaData.mtd
/IdeSrc/Workspace.loc
/IdeSrc/*.dsk

# Cache de base de datos
/Data/*.cch

# Copias de seguridad y temporales
*.bak
*.tmp
Thumbs.db
Desktop.ini
/Data/reindex.log
# Clave de cifrado local: no publicar
/AppSrc/LoginEncryptionKey.inc

# Registro de mantenimiento
/Data/reindex.log
/AppSrc/WebAppLocalSecrets.inc
# Conexion local: puede contener credenciales
/Data/DFConnId.ini

# Datos locales y archivos auxiliares de tablas
/Data/*.dat
/Data/*.hdr
/Data/*.tag
/Data/*.k[0-9]*

# Registros locales
/Data/*.log

# Metadatos locales de Studio, incluidas versiones de 64 bits
/IdeSrc/*.mtd